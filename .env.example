# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for the browser, RLS enforced.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose to the client. Used by the
# background worker for ingestion tasks that bypass RLS intentionally.
SUPABASE_SERVICE_ROLE_KEY=
# Hostname used by next/image for Storage-served images, e.g. abcdefgh.supabase.co
SUPABASE_IMAGE_HOSTNAME=

# ---------------------------------------------------------------------------
# Database (background queue — pg-boss connects directly to Postgres)
# ---------------------------------------------------------------------------
# Use the Supabase connection string (Session pooler or direct). SERVER ONLY.
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Which provider handles each capability. Values: ollama | openrouter | openai | anthropic | gemini
AI_TEXT_PROVIDER=ollama
AI_VISION_PROVIDER=ollama
AI_EMBEDDING_PROVIDER=ollama
AI_TRANSCRIPTION_PROVIDER=ollama

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=hermes3
OLLAMA_VISION_MODEL=llama3.2-vision
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud providers (optional — only needed if selected above)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Media ingestion
# ---------------------------------------------------------------------------
# Comma-separated absolute paths the ingestion worker watches.
MEDIA_WATCH_FOLDERS=
# Supabase Storage bucket for media + thumbnails.
MEDIA_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Social publishing (Phase 3)
# ---------------------------------------------------------------------------
# Base URL used to build OAuth redirect URIs.
APP_URL=http://localhost:3000
# 32-byte base64 key encrypting OAuth tokens at rest. REQUIRED for social
# features. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Allow the mock provider so you can test connect/schedule/publish locally
# without real app credentials. Set to false in production.
SOCIAL_ALLOW_MOCK=true
# Real platform OAuth apps (optional; a platform is "configured" only when both
# id and secret are present). Example for Facebook:
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
